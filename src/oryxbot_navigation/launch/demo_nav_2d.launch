<!--                                                                            
  oryxbot navigation simulation:
  - gazebo
  - map_server
  - move_base
  - amcl
  - rviz view
 --> 

<launch>
	<arg name="open_nav_rviz" default="true"/>
	<arg name="map_file_name" default="home"/>
	<!--gazebo-->
	<include file="$(find oryxbot_gazebo)/launch/gazebo.launch"/>
	<!--map_server-->
	<include file="$(find oryxbot_navigation)/launch/map_server.launch">
		<arg name="map_file" value="$(arg map_file_name)"/>
	</include>
	<!--move_base-->
	<include file="$(find oryxbot_navigation)/launch/move_base_sim.launch"/>
	<!--amcl-->
	<include file="$(find oryxbot_navigation)/launch/amcl_sim.launch"/>
	<!--  **************** Visualisation ****************  -->
	<group if="$(arg open_nav_rviz)">
  		<node name="rviz" pkg="rviz" type="rviz" args="-d $(find oryxbot_navigation)/rviz/navigation.rviz"/>
	</group>

</launch>
