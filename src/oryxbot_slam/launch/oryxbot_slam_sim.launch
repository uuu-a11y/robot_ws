<launch>
  <!-- Arguments -->
  <arg name="slam_methods" default="gmapping_sim" doc="slam type [gmapping, gmapping_sim, cartographer]"/>
  <arg name="configuration_basename" default="oryxbot_2d.lua"/>
  <arg name="open_rviz" default="true"/>

  <!-- oryxbot -->
  <include file="$(find oryxbot_description)/launch/gazebo.launch"/>

  <!-- SLAM: Gmapping, Cartographer, Hector, Karto, Frontier_exploration, RTAB-Map -->
  <include file="$(find oryxbot_slam)/launch/oryxbot_$(arg slam_methods).launch">   
    <arg name="configuration_basename" value="$(arg configuration_basename)"/>
  </include>

  <!-- rviz -->
  <group if="$(arg open_rviz)">
    <node pkg="rviz" type="rviz" name="rviz" required="true" args="-d $(find oryxbot_slam)/rviz/oryxbot_$(arg slam_methods).rviz"/>
  </group>
</launch>
